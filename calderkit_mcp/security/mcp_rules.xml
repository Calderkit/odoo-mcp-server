<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mcp_log_own" model="ir.rule">
        <field name="name">MCP calls: own calls</field>
        <field name="model_id" ref="model_calderkit_mcp_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>

    <record id="rule_mcp_log_all" model="ir.rule">
        <field name="name">MCP calls: all calls</field>
        <field name="model_id" ref="model_calderkit_mcp_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_manager'))]"/>
    </record>
</odoo>
