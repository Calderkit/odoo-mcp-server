<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_model_list" model="ir.ui.view">
        <field name="name">calderkit.mcp.model.list</field>
        <field name="model">calderkit.mcp.model</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <button name="action_add_defaults" type="object" string="Add Default Models"
                            display="always" groups="calderkit_mcp.group_mcp_manager"/>
                </header>
                <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="model_name"/>
                <field name="hint"/>
                <field name="max_records" optional="show"/>
                <field name="excluded_field_ids" widget="many2many_tags" optional="show"
                       options="{'no_create': True}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_model_form" model="ir.ui.view">
        <field name="name">calderkit.mcp.model.form</field>
        <field name="model">calderkit.mcp.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="model_name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="max_records"/>
                        </group>
                    </group>
                    <group>
                        <field name="hint" placeholder="e.g. Quotations and sales orders"/>
                        <field name="excluded_field_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">calderkit.mcp.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Choose what AI assistants can use</p>
            <p>Only the models in this list are visible through MCP, and only with the
               access rights of the connected user. Passwords, tokens, keys and files are never shown.</p>
        </field>
    </record>
</odoo>
