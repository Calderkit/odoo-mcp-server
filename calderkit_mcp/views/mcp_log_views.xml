<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_log_list" model="ir.ui.view">
        <field name="name">calderkit.mcp.log.list</field>
        <field name="model">calderkit.mcp.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="status == 'error'">
                <field name="create_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="result_count"/>
                <field name="duration_ms" optional="show"/>
                <field name="client" optional="show"/>
                <field name="status" widget="badge" decoration-success="status == 'ok'"
                       decoration-danger="status == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_log_form" model="ir.ui.view">
        <field name="name">calderkit.mcp.log.form</field>
        <field name="model">calderkit.mcp.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="tool"/>
                            <field name="model_name"/>
                            <field name="status" widget="badge" decoration-success="status == 'ok'"
                                   decoration-danger="status == 'error'"/>
                            <field name="result_count"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="client"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group>
                        <field name="arguments" widget="code" options="{'mode': 'javascript'}"/>
                        <field name="error" invisible="not error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_log_search" model="ir.ui.view">
        <field name="name">calderkit.mcp.log.search</field>
        <field name="model">calderkit.mcp.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="user_id"/>
                <field name="client"/>
                <filter name="filter_error" string="Errors" domain="[('status', '=', 'error')]"/>
                <filter name="filter_date" string="Date" date="create_date"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_tool" string="Tool" context="{'group_by': 'tool'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_log" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">calderkit.mcp.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mcp_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No calls yet</p>
            <p>Every tool an AI assistant runs through MCP is listed here.</p>
        </field>
    </record>
</odoo>
